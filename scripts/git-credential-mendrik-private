#!/bin/sh
# Repository-local Git helper: never consult the globally active gh account.
set -eu
[ "${1:-}" = get ] || exit 0
protocol=
host=
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
    esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
token=$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com --user mendrik-private)
[ -n "$token" ] || exit 1
printf 'username=mendrik-private\npassword=%s\n' "$token"
